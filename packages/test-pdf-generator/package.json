{
  "name": "@tc/test-pdf-generator",
  "version": "0.1.0",
  "private": true,
  "description": "Generate filled test PDFs from blank C.A.R. templates + fixture JSON data",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "grid": "node scripts/grid-overlay.mjs"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
