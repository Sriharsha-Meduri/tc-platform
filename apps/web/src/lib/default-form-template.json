{
  "CA": {
    "residential": {
      "buyer_side": {
        "INTAKE": [
          { "code": "BRBC",   "name": "Buyer Representation and Broker Compensation Agreement", "required": "mandatory", "notes": "Required before showing any property (NAR mandate, effective 8/17/2024)" },
          { "code": "AD",     "name": "Disclosure Regarding Real Estate Agency Relationships",   "required": "mandatory", "notes": "Required at first substantive contact" },
          { "code": "FHDA",   "name": "Fair Housing and Discrimination Advisory",                "required": "optional"  },
          { "code": "CCPA",   "name": "California Consumer Privacy Act Advisory",                "required": "optional"  }
        ],
        "CONTRACT": [
          { "code": "RPA",    "name": "Residential Purchase Agreement and Joint Escrow Instructions", "required": "mandatory" },
          { "code": "AD",     "name": "Disclosure Regarding Real Estate Agency Relationships",        "required": "mandatory", "notes": "Required at first substantive contact; re-confirmed at offer" },
          { "code": "AVID",   "name": "Agent Visual Inspection Disclosure",                           "required": "mandatory" },
          { "code": "BIA",    "name": "Buyer's Investigation Advisory",                               "required": "optional"  },
          { "code": "BCO",    "name": "Buyer Counter Offer",                                          "required": "optional"  },
          { "code": "BMCO",   "name": "Buyer Multiple Counter Offer Selection",                        "required": "optional"  },
          { "code": "WFA",    "name": "Wire Fraud and Electronic Funds Transfer Advisory",             "required": "optional"  },
          { "code": "PRBS",   "name": "Possible Representation of More Than One Buyer or Seller",     "required": "optional", "notes": "Required if dual agency" },
          { "code": "FHA-VA", "name": "FHA/VA and Conventional Financing Advisory",                   "required": "optional"  },
          { "code": "PED",    "name": "Parent/Guardian Authorization for Minor Signatory",             "required": "conditional", "notes": "Required when any party is a minor" },
          { "code": "FRR-PA", "name": "Federal Reporting Requirement Purchase Addendum",               "required": "conditional", "notes": "Required for all-cash purchases meeting FinCEN thresholds" },
          { "code": "AADDM",  "name": "Addendum",                                                     "required": "optional"  }
        ],
        "DISCLOSURES": [
          { "code": "TDS",    "name": "Real Estate Transfer Disclosure Statement",        "required": "mandatory", "notes": "Provided by seller; buyer must review" },
          { "code": "SPQ",    "name": "Seller Property Questionnaire",                   "required": "mandatory", "notes": "Provided by seller; buyer must review" },
          { "code": "NHD",    "name": "Natural Hazard Disclosure Statement",             "required": "mandatory", "notes": "Provided by seller; buyer must review" },
          { "code": "AVID",   "name": "Agent Visual Inspection Disclosure",              "required": "mandatory"  },
          { "code": "SBSA",   "name": "Statewide Buyer and Seller Advisory",             "required": "optional"  },
          { "code": "SPQR",   "name": "Supplemental Seller Property Questionnaire",      "required": "optional"  },
          { "code": "BIA",    "name": "Buyer's Investigation Advisory",                  "required": "optional"  },
          { "code": "BHIA",   "name": "Buyer Homeowners' Insurance Advisory",            "required": "optional"  },
          { "code": "AEA",    "name": "Agent Environmental Advisory",                    "required": "optional"  },
          { "code": "SEA",    "name": "Solar Energy Advisory",                           "required": "optional"  },
          { "code": "HAA",    "name": "Home Affordability Advisory",                     "required": "optional"  },
          { "code": "RSPA",   "name": "Residential Square Footage Advisory",             "required": "optional"  },
          { "code": "HOA",    "name": "Homeowners Association Information and Addendum", "required": "conditional", "notes": "Required when property is in HOA/condo/PUD" },
          { "code": "WPA",    "name": "Water-Saving Plumbing Retrofit Disclosure",       "required": "conditional", "notes": "Required when property lacks compliant fixtures" },
          { "code": "MELLO",  "name": "Mello-Roos and Special Assessment Disclosure",    "required": "conditional", "notes": "Required when property has Mello-Roos or special assessments" },
          { "code": "WHSD",   "name": "Residential Earthquake Hazards Report",           "required": "conditional", "notes": "Required for properties built before 1960 with certain structural types" },
          { "code": "NSP",    "name": "Notice to Seller to Perform",                     "required": "optional"  }
        ],
        "INSPECTION": [
          { "code": "RR",     "name": "Request for Repair",                   "required": "optional" },
          { "code": "PEAD",   "name": "Pest Control Disclosure and Addendum", "required": "optional" },
          { "code": "NSP",    "name": "Notice to Seller to Perform",          "required": "optional" },
          { "code": "AADDM",  "name": "Addendum",                             "required": "optional" }
        ],
        "APPRAISAL": [
          { "code": "CR-B",   "name": "Contingency Removal (Buyer)", "required": "optional", "notes": "Used to remove appraisal contingency" },
          { "code": "AADDM",  "name": "Addendum",                    "required": "optional" }
        ],
        "LOAN": [
          { "code": "CR-B",   "name": "Contingency Removal (Buyer)", "required": "optional", "notes": "Used to remove loan contingency" },
          { "code": "AADDM",  "name": "Addendum",                    "required": "optional" }
        ],
        "ESCROW": [
          { "code": "VP",     "name": "Verification of Property Condition",      "required": "optional" },
          { "code": "IDA",    "name": "Increased Deposit Addendum",              "required": "optional" },
          { "code": "RID",    "name": "Residential Interim Occupancy Agreement", "required": "optional", "notes": "Use if buyer occupies before close" },
          { "code": "HWA",    "name": "Home Warranty Addendum",                  "required": "optional" },
          { "code": "DCE",    "name": "Demand to Close Escrow",                  "required": "optional" }
        ],
        "CLOSING": [
          { "code": "ABA",    "name": "Additional Broker Acknowledgement",            "required": "optional" },
          { "code": "CC",     "name": "Cancellation of Contract, Release of Deposit", "required": "optional", "notes": "Use only if transaction cancels" }
        ],
        "POST_CLOSE": []
      },
      "seller_side": {
        "INTAKE": [
          { "code": "RLA",    "name": "Residential Listing Agreement — Exclusive Authorization and Right to Sell", "required": "mandatory" },
          { "code": "AD",     "name": "Disclosure Regarding Real Estate Agency Relationships",                      "required": "mandatory", "notes": "Required at first substantive contact" },
          { "code": "FHDA",   "name": "Fair Housing and Discrimination Advisory",                                   "required": "optional"  },
          { "code": "CCPA",   "name": "California Consumer Privacy Act Advisory",                                   "required": "optional"  },
          { "code": "RSPA",   "name": "Residential Square Footage Advisory",                                        "required": "optional"  }
        ],
        "CONTRACT": [
          { "code": "RPA",    "name": "Residential Purchase Agreement and Joint Escrow Instructions", "required": "mandatory" },
          { "code": "AD",     "name": "Disclosure Regarding Real Estate Agency Relationships",        "required": "mandatory", "notes": "Required at first substantive contact; re-confirmed at offer" },
          { "code": "AVID",   "name": "Agent Visual Inspection Disclosure",                           "required": "mandatory" },
          { "code": "BIA",    "name": "Buyer's Investigation Advisory",                               "required": "optional"  },
          { "code": "SCO",    "name": "Seller Counter Offer",                                         "required": "optional"  },
          { "code": "SMCO",   "name": "Seller Multiple Counter Offer",                                "required": "optional"  },
          { "code": "WFA",    "name": "Wire Fraud and Electronic Funds Transfer Advisory",             "required": "optional"  },
          { "code": "PRBS",   "name": "Possible Representation of More Than One Buyer or Seller",     "required": "optional", "notes": "Required if dual agency" },
          { "code": "PED",    "name": "Parent/Guardian Authorization for Minor Signatory",             "required": "conditional", "notes": "Required when any party is a minor" },
          { "code": "FRR-PA", "name": "Federal Reporting Requirement Purchase Addendum",               "required": "conditional", "notes": "Required for all-cash sales meeting FinCEN thresholds" },
          { "code": "AADDM",  "name": "Addendum",                                                     "required": "optional"  }
        ],
        "DISCLOSURES": [
          { "code": "TDS",     "name": "Real Estate Transfer Disclosure Statement",    "required": "mandatory", "notes": "Required by California Civil Code §1102 for all 1–4 unit residential sales" },
          { "code": "SPQ",     "name": "Seller Property Questionnaire",                "required": "mandatory" },
          { "code": "NHD",     "name": "Natural Hazard Disclosure Statement",          "required": "mandatory", "notes": "Typically ordered from a third-party NHD provider" },
          { "code": "AVID",    "name": "Agent Visual Inspection Disclosure",           "required": "mandatory" },
          { "code": "SBSA",    "name": "Statewide Buyer and Seller Advisory",          "required": "optional"  },
          { "code": "SPQR",    "name": "Supplemental Seller Property Questionnaire",   "required": "optional"  },
          { "code": "AEA",     "name": "Agent Environmental Advisory",                 "required": "optional"  },
          { "code": "SEA",     "name": "Solar Energy Advisory",                        "required": "optional"  },
          { "code": "HOA",     "name": "Homeowners Association Information and Addendum", "required": "conditional", "notes": "Required when property is in HOA/condo/PUD" },
          { "code": "SOLAR-A", "name": "Solar Panels and Systems Addendum",            "required": "conditional", "notes": "Required when property has solar panels (owned or leased)" },
          { "code": "WPA",     "name": "Water-Saving Plumbing Retrofit Disclosure",    "required": "conditional", "notes": "Required when property lacks compliant fixtures" },
          { "code": "MELLO",   "name": "Mello-Roos and Special Assessment Disclosure", "required": "conditional", "notes": "Required when property has Mello-Roos or special assessments" },
          { "code": "WHSD",    "name": "Residential Earthquake Hazards Report",        "required": "conditional", "notes": "Required for properties built before 1960 with certain structural types" },
          { "code": "NBP",     "name": "Notice to Buyer to Perform",                   "required": "optional"  }
        ],
        "INSPECTION": [
          { "code": "RRRR",   "name": "Seller's Response to Buyer's Request for Repair", "required": "optional" },
          { "code": "PEAD",   "name": "Pest Control Disclosure and Addendum",             "required": "optional" },
          { "code": "CR-S",   "name": "Contingency Removal (Seller)",                     "required": "optional" },
          { "code": "NBP",    "name": "Notice to Buyer to Perform",                       "required": "optional" }
        ],
        "APPRAISAL": [
          { "code": "NBP",    "name": "Notice to Buyer to Perform", "required": "optional", "notes": "If appraisal contingency removal deadline passes" },
          { "code": "AADDM",  "name": "Addendum",                   "required": "optional" }
        ],
        "LOAN": [
          { "code": "NBP",    "name": "Notice to Buyer to Perform", "required": "optional", "notes": "If loan contingency removal deadline passes" },
          { "code": "AADDM",  "name": "Addendum",                   "required": "optional" }
        ],
        "ESCROW": [
          { "code": "VP",     "name": "Verification of Property Condition",              "required": "optional" },
          { "code": "RLEO",   "name": "Residential Lease After Sale (Seller Leaseback)", "required": "optional", "notes": "Use if seller stays after close" },
          { "code": "DCE",    "name": "Demand to Close Escrow",                          "required": "optional" },
          { "code": "HWA",    "name": "Home Warranty Addendum",                          "required": "optional" }
        ],
        "CLOSING": [
          { "code": "ABA",    "name": "Additional Broker Acknowledgement",             "required": "optional" },
          { "code": "CC",     "name": "Cancellation of Contract, Release of Deposit",  "required": "optional", "notes": "Use only if transaction cancels" }
        ],
        "POST_CLOSE": []
      }
    }
  }
}
