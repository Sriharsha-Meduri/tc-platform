{
  "name": "@tc/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "cross-env APP_ENV=local nest start --watch",
    "start": "node dist/main",
    "lint": "eslint src/",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "migration:run": "cross-env APP_ENV=local typeorm-ts-node-commonjs migration:run    -d src/database/data-source.ts",
    "migration:run:dev": "cross-env APP_ENV=dev typeorm-ts-node-commonjs migration:run    -d src/database/data-source.ts",
    "migration:run:prod": "cross-env APP_ENV=production typeorm                   migration:run    -d dist/database/data-source.js",
    "migration:revert": "cross-env APP_ENV=local typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "migration:revert:dev": "cross-env APP_ENV=dev typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "migration:generate": "cross-env APP_ENV=local typeorm-ts-node-commonjs migration:generate src/database/migrations/$npm_config_name -d src/database/data-source.ts",
    "migration:show": "cross-env APP_ENV=local typeorm-ts-node-commonjs migration:show    -d src/database/data-source.ts",
    "seed": "cross-env APP_ENV=local ts-node -r tsconfig-paths/register src/database/seeds/seed.ts",
    "seed:dev": "cross-env APP_ENV=dev ts-node -r tsconfig-paths/register src/database/seeds/seed.ts",
    "db:setup": "pnpm migration:run     && pnpm seed",
    "db:setup:dev": "pnpm migration:run:dev && pnpm seed:dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@apollo/server": "^4.0.0",
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/credential-providers": "^3.1081.0",
    "@aws-sdk/s3-request-presigner": "^3.1041.0",
    "@google/generative-ai": "^0.24.1",
    "@nestjs/apollo": "^12.0.0",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/graphql": "^12.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^4.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^10.0.0",
    "@tc/document-intelligence": "workspace:*",
    "@tc/shared": "workspace:*",
    "@tc/test-pdf-generator": "workspace:*",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "graphql": "^16.0.0",
    "hbs": "^4.0.0",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.0.0",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.0.0",
    "typeorm": "^0.3.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@tc/config": "workspace:*",
    "@types/bcryptjs": "^2.4.0",
    "@types/bull": "^4.10.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.0.0",
    "@types/hbs": "^4.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.0.0",
    "cross-env": "^7.0.3",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
