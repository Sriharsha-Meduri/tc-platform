<h1>Dashboard</h1>
<div class="stats">
  <div class="stat-card">
    <h3>Total Users</h3>
    <p>{{stats.totalUsers}}</p>
  </div>
  <div class="stat-card">
    <h3>Pending Users</h3>
    <p>{{stats.pendingUsers}}</p>
  </div>
  <div class="stat-card">
    <h3>Organizations</h3>
    <p>{{stats.totalOrganizations}}</p>
  </div>
  <div class="stat-card">
    <h3>Pending Approval</h3>
    <p>{{stats.pendingOrganizations}}</p>
  </div>
</div>
