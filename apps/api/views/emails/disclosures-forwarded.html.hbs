<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="margin:0; padding:0; background-color:#f4f6f8; font-family:Arial, Helvetica, sans-serif; color:#1b2431;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f6f8; padding:24px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="background-color:#ffffff; border-radius:10px; overflow:hidden; border:1px solid #e2e5ea;">
          <tr>
            <td style="background-color:#2e7d5b; padding:22px 32px;">
              <div style="color:#ffffff; font-size:18px; font-weight:bold;">Seller Disclosures Completed</div>
              <div style="color:#d3ece0; font-size:14px; margin-top:4px;">{{propertyAddress}}</div>
            </td>
          </tr>
          <tr>
            <td style="padding:28px 32px;">
              <p style="margin:0 0 16px; font-size:15px; line-height:1.6;">Hello,</p>
              <p style="margin:0 0 16px; font-size:15px; line-height:1.6;">
                The seller disclosures for <strong>{{propertyAddress}}</strong> have been completed and reviewed. They are ready for the buyer to review and sign.
              </p>
              {{#if hasDocuments}}
              <h3 style="margin:20px 0 8px; font-size:13px; text-transform:uppercase; letter-spacing:0.06em; color:#5a6473;">Disclosure forms</h3>
              <ul style="margin:0; padding-left:20px; font-size:14px; line-height:1.7;">
                {{#each documentTitles}}<li>{{this}}</li>{{/each}}
              </ul>
              {{/if}}
              <p style="margin:20px 0 0; font-size:14px; line-height:1.6;">
                Please have the buyer review and sign, and return the signed disclosures at your earliest convenience.
              </p>
              <p style="margin:20px 0 0; font-size:13px; line-height:1.6; color:#5a6473;">
                Transaction reference: {{txNumber}}
              </p>
            </td>
          </tr>
          <tr>
            <td style="background-color:#f4f6f8; padding:20px 32px; border-top:1px solid #e2e5ea;">
              <p style="margin:0; font-size:13px; line-height:1.6; color:#5a6473;">
                {{tcName}}<br>
                {{tcPhone}}<br>
                {{transactionEmail}}
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
