<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"></head>
<body style="font-family:sans-serif;background:#f8fafc;margin:0;padding:32px;">
  <div style="max-width:520px;margin:0 auto;background:#fff;border-radius:12px;padding:40px;box-shadow:0 2px 8px rgba(0,0,0,0.08);">

    <!-- Header -->
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:28px;">
      <div style="background:#1d4ed8;color:#fff;font-size:18px;font-weight:700;padding:10px 16px;border-radius:8px;letter-spacing:.5px;">TC</div>
      <span style="color:#6b7280;font-size:14px;">Transaction Coordination Platform</span>
    </div>

    <!-- Alert banner -->
    <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:14px 16px;margin-bottom:24px;display:flex;align-items:center;gap:10px;">
      <span style="font-size:20px;">🚫</span>
      <strong style="color:#b91c1c;font-size:15px;">Contract Submission Voided</strong>
    </div>

    <!-- Greeting -->
    <p style="color:#374151;font-size:14px;margin:0 0 6px;">Dear Agent,</p>
    <p style="color:#6b7280;font-size:14px;margin:0 0 24px;">
      We are unable to proceed with the transaction for the property at:
    </p>

    <!-- Property info -->
    <div style="background:#f1f5f9;border-radius:8px;padding:16px 20px;margin-bottom:24px;">
      <p style="margin:0;font-weight:600;color:#111827;font-size:15px;">{{address}}</p>
      {{#if txNumber}}<p style="margin:6px 0 0;font-size:13px;color:#6b7280;">Transaction #{{txNumber}}</p>{{/if}}
    </div>

    <p style="color:#374151;font-size:14px;margin:0 0 24px;">
      The contract submission has been voided. Please review the issues listed below and resubmit a corrected contract.
    </p>

    <!-- Missing required fields -->
    {{#if missingFields}}
    <div style="margin-bottom:20px;">
      <p style="margin:0 0 10px;font-size:12px;font-weight:700;color:#b91c1c;text-transform:uppercase;letter-spacing:.6px;">Missing Required Information</p>
      <div style="border:1px solid #fecaca;border-radius:8px;overflow:hidden;">
        {{#each missingFields}}
        <div style="padding:10px 14px;{{#unless @last}}border-bottom:1px solid #fecaca;{{/unless}}display:flex;align-items:flex-start;gap:8px;">
          <span style="color:#b91c1c;font-size:14px;margin-top:1px;">•</span>
          <span style="color:#374151;font-size:14px;">{{this}}</span>
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}

    <!-- Compliance failures -->
    {{#if complianceFailures}}
    <div style="margin-bottom:20px;">
      <p style="margin:0 0 10px;font-size:12px;font-weight:700;color:#92400e;text-transform:uppercase;letter-spacing:.6px;">Compliance Issues</p>
      <div style="border:1px solid #fde68a;border-radius:8px;overflow:hidden;">
        {{#each complianceFailures}}
        <div style="padding:10px 14px;{{#unless @last}}border-bottom:1px solid #fde68a;{{/unless}}">
          <div style="display:flex;align-items:flex-start;gap:8px;">
            <span style="color:#92400e;font-size:14px;margin-top:1px;">•</span>
            <div>
              <span style="color:#374151;font-size:14px;font-weight:500;">[{{formCode}}] {{label}}</span>
              {{#if detail}}<p style="margin:3px 0 0;color:#6b7280;font-size:13px;">{{detail}}</p>{{/if}}
            </div>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}

    <!-- Missing forms -->
    {{#if missingForms}}
    <div style="margin-bottom:20px;">
      <p style="margin:0 0 10px;font-size:12px;font-weight:700;color:#1d4ed8;text-transform:uppercase;letter-spacing:.6px;">Missing Forms &amp; Disclosures</p>
      <div style="border:1px solid #bfdbfe;border-radius:8px;overflow:hidden;">
        {{#each missingForms}}
        <div style="padding:10px 14px;{{#unless @last}}border-bottom:1px solid #bfdbfe;{{/unless}}display:flex;align-items:flex-start;gap:8px;">
          <span style="color:#1d4ed8;font-size:14px;margin-top:1px;">•</span>
          <span style="color:#374151;font-size:14px;">{{title}}{{#if formCode}} <span style="color:#6b7280;">({{formCode}})</span>{{/if}}</span>
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}

    <!-- No issues fallback -->
    {{#unless hasIssues}}
    <p style="color:#6b7280;font-size:14px;margin:0 0 24px;">
      No specific issues were automatically detected. Please review the contract carefully and resubmit.
    </p>
    {{/unless}}

    <p style="color:#374151;font-size:14px;margin:24px 0 0;">
      Please correct the above issues and resubmit the contract at your earliest convenience.
    </p>

    <hr style="border:none;border-top:1px solid #e5e7eb;margin:28px 0 16px;">
    <p style="color:#9ca3af;font-size:12px;margin:0;text-align:center;">TC Platform &mdash; Real Estate Transaction Coordination</p>

  </div>
</body>
</html>
