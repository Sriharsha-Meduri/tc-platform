<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"></head>
<body style="font-family:sans-serif;background:#f8fafc;margin:0;padding:32px;">
  <div style="max-width:520px;margin:0 auto;background:#fff;border-radius:12px;padding:40px;box-shadow:0 2px 8px rgba(0,0,0,0.08);">

    <div style="display:flex;align-items:center;gap:12px;margin-bottom:28px;">
      <div style="background:#1d4ed8;color:#fff;font-size:18px;font-weight:700;padding:10px 16px;border-radius:8px;letter-spacing:.5px;">TC</div>
      <span style="color:#6b7280;font-size:14px;">Transaction Coordination Platform</span>
    </div>

    <div style="background:#f0f9ff;border:1px solid #bae6fd;border-radius:8px;padding:14px 16px;margin-bottom:24px;display:flex;align-items:center;gap:10px;">
      <span style="font-size:20px;">🏠</span>
      <strong style="color:#0369a1;font-size:15px;">Verification of Property — Scheduled Today</strong>
    </div>

    <h2 style="color:#111827;font-size:20px;margin:0 0 4px;">Hi {{name}},</h2>
    <p style="color:#6b7280;font-size:14px;margin:0 0 24px;">{{role}}</p>

    <div style="background:#fefce8;border:1px solid #fde68a;border-radius:8px;padding:20px;margin-bottom:24px;">
      <p style="margin:0 0 8px;font-size:13px;color:#92400e;font-weight:600;">Action Required</p>
      <p style="margin:0 0 12px;font-size:15px;color:#111827;">
        The <strong>Verification of Property (VP)</strong> inspection is scheduled for
        <strong style="color:#92400e;">{{inspectionDate}}</strong>.
      </p>
      <p style="margin:0;font-size:14px;color:#6b7280;">
        The completed <strong>Verification of Property (VP)</strong> form is required before closing.
      </p>
    </div>

    <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;padding:20px;margin-bottom:24px;">
      <p style="margin:0 0 6px;font-size:14px;font-weight:600;color:#166534;">
        Next Steps
      </p>
      <ol style="margin:0;padding-left:18px;color:#166534;font-size:14px;line-height:1.8;">
        <li>Complete the Verification of Property inspection today</li>
        <li><strong>Reply to this email</strong> with the completed VP form attached — replies are automatically tracked and attachments are processed immediately</li>
        <li>Or upload the completed VP form directly through MyTC</li>
        {{#if uploadLink}}
        <li>
          Use this secure upload link:
          <br><a href="{{uploadLink}}" style="color:#1d4ed8;font-weight:500;">{{uploadLink}}</a>
        </li>
        {{/if}}
      </ol>
    </div>

    <div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:8px;padding:16px;margin-bottom:24px;">
      <p style="margin:0;font-size:13px;color:#1e40af;">
        <strong>Automatic Processing:</strong> Replies to this email are monitored by MyTC. Any attached VP form will be automatically detected, validated, and saved to the closing documents — no manual upload needed.
      </p>
    </div>

    <table style="width:100%;border-collapse:collapse;font-size:14px;margin-bottom:28px;">
      <tr>
        <td style="padding:8px 0;color:#9ca3af;width:120px;">Property</td>
        <td style="padding:8px 0;color:#111827;font-weight:500;">{{address}}</td>
      </tr>
      <tr>
        <td style="padding:8px 0;color:#9ca3af;">Transaction #</td>
        <td style="padding:8px 0;color:#111827;font-weight:500;">{{txNumber}}</td>
      </tr>
    </table>

    <p style="color:#6b7280;font-size:13px;margin:0;">
      This is an automated reminder. The Verification of Property (VP) form is a required closing document.
      Please ensure it is uploaded promptly after the inspection.
    </p>

    <hr style="border:none;border-top:1px solid #e5e7eb;margin:24px 0;">
    <p style="color:#9ca3af;font-size:12px;margin:0;text-align:center;">TC Platform &mdash; Real Estate Transaction Coordination</p>
  </div>
</body>
</html>
