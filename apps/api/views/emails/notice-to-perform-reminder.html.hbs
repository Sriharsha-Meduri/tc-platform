<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="margin:0; padding:0; background-color:#f4f6f8; font-family:Arial, Helvetica, sans-serif; color:#1b2431;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f6f8; padding:24px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="background-color:#ffffff; border-radius:10px; overflow:hidden; border:1px solid #e2e5ea;">
          <tr>
            <td style="background-color:#9a3324; padding:22px 32px;">
              <div style="color:#ffffff; font-size:18px; font-weight:bold;">Consider a Notice to Perform</div>
              <div style="color:#f0d6d0; font-size:14px; margin-top:4px;">{{propertyAddress}}</div>
            </td>
          </tr>
          <tr>
            <td style="padding:28px 32px;">
              <p style="margin:0 0 16px; font-size:15px; line-height:1.6;">Hello {{recipientName}},</p>
              <p style="margin:0 0 16px; font-size:15px; line-height:1.6;">
                The <strong>{{contingencyLabel}}</strong> deadline on <strong>{{propertyAddress}}</strong> was {{deadlineDisplay}},
                and the contingency has not been removed. It has now been {{ntpDays}} day(s) past the deadline.
              </p>
              <p style="margin:0 0 16px; font-size:15px; line-height:1.6;">
                You may want to issue a Notice to Perform (NTP) to the buyer side. Review the file and take the appropriate next step.
              </p>
              <p style="margin:24px 0 0; font-size:13px; line-height:1.6; color:#5a6473;">
                Transaction reference: {{transactionNumber}}
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
